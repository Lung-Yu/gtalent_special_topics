{
  "title": "Cache Overview",
  "uid": "cache-overview",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Category Cache Hit Rate (5m)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(rate(app_cache_requests_total{cache=\"categories\",result=\"hit\"}[5m])) / clamp_min(sum(rate(app_cache_requests_total{cache=\"categories\",result=~\"hit|miss\"}[5m])), 1e-9)",
          "legendFormat": "hit rate"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "color": { "mode": "palette-classic" }
        }
      }
    },
    {
      "id": 2,
      "title": "Category Cache Hit/Miss QPS",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(rate(app_cache_requests_total{cache=\"categories\",result=\"hit\"}[1m]))",
          "legendFormat": "hit"
        },
        {
          "datasource": "Prometheus",
          "expr": "sum(rate(app_cache_requests_total{cache=\"categories\",result=\"miss\"}[1m]))",
          "legendFormat": "miss"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": { "mode": "palette-classic" }
        }
      }
    },
    {
      "id": 3,
      "title": "Category Cache Requests by Operation (rpm)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum by (operation) (rate(app_cache_requests_total{cache=\"categories\",result=~\"hit|miss\"}[1m])) * 60",
          "legendFormat": "{{operation}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqpm",
          "color": { "mode": "palette-classic" }
        }
      }
    },
    {
      "id": 4,
      "title": "Category Cache Evictions (1h)",
      "type": "stat",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "increase(app_cache_evictions_total{cache=\"categories\"}[1h])",
          "legendFormat": "evictions"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 10 }
            ]
          }
        }
      }
    }
  ]
}
